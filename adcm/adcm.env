# ADCM Environment Configuration
# Copy to adcm.env and customize passwords

# Database
ADCM_DB_PASSWORD=zeer_adcm_db_2026

# ADCM Admin
ADCM_ADMIN_PASSWORD=zeer_admin_2026

# License (place license file in ./license/ or set path)
# ADCM_LICENSE_PATH=/adcm/data/license.json

# Cluster Name
ADCM_CLUSTER_NAME=zeer-bigdata-cluster

# Network
ADCM_NETWORK=192.168.1.0/24

# SSH User for node management
ADCM_SSH_USER=hadoop
ADCM_SSH_KEY_PATH=/home/hadoop/.ssh/id_rsa